package layout

import "workshop/web/views/components"

type BaseProps struct {
	// Title goes in the tab and in the page's own metadata.
	Title string
	// Description is the one line a link unfurls with when it's pasted
	// into a chat, which is where this site gets shared.
	Description string
	// Map loads Leaflet, which only the game needs, so every other page
	// is served without it.
	Map bool
	// Globe loads three.js, which only the globe needs. Half a megabyte of
	// renderer has no business on a page that is not drawing one.
	Globe bool
	// Class marks the body, so a page can restyle the chrome around it.
	Class string
	// FooterGopher sends a gopher along the top of the footer. It is
	// opt-in, and off wherever the page is working: the game never sets it,
	// because attention there belongs to the photograph and the map.
	FooterGopher bool
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.Title } · Sightings Safari</title>
			<meta name="description" content={ props.Description }/>
			<meta name="color-scheme" content="dark"/>
			<!-- So a link pasted into Slack unfurls as something worth clicking. -->
			<meta property="og:title" content={ props.Title }/>
			<meta property="og:description" content={ props.Description }/>
			<meta property="og:type" content="website"/>
			<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..600&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500;700&display=swap"
			/>
			if props.Map {
				<link
					rel="stylesheet"
					href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
					integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
					crossorigin="anonymous"
					referrerpolicy="no-referrer"
				/>
			}
			<link rel="stylesheet" href="/assets/css/app.css"/>
		</head>
		<body class={ props.Class }>
			<a class="skip" href="#main">Skip to the content</a>
			<header class="masthead">
				<a class="brand" href="/">
					@logo()
					<span class="brand__name">
						Sightings <em>Safari</em>
					</span>
				</a>
				<nav class="nav" aria-label="Main">
					<a href="/">The record</a>
					<a class="nav__cta" href="/play">Play</a>
				</nav>
			</header>
			<main id="main" class="container">
				{ children... }
			</main>
			if props.FooterGopher {
				<div class="gopher-lane gopher-lane--footer" aria-hidden="true">
					@components.Gopher("gopher--run")
				</div>
			}
			<footer class="footer">
				<p>
					Occurrence records from <a href="https://www.gbif.org" rel="noopener">GBIF</a>,
					weather from <a href="https://open-meteo.com" rel="noopener">Open-Meteo</a>.
					Photographs belong to the naturalists credited beside them.
				</p>
				<p class="footer__built">Built in Go with sqlc and templ · GopherCon Africa 2026</p>
			</footer>
			if props.Map {
				<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
				<!-- After Leaflet: deferred scripts run in document order. -->
				<script src="/assets/js/safari.js" defer></script>
			}
			if props.Globe {
				<!--
					r160 is the last three.js that ships a build with a global THREE,
					which is what a site with no bundler can use. Pinned to the exact
					version with its hash, as Leaflet is: a script this size, from
					somebody else's server, should not be able to change under us.
				-->
				<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js" integrity="sha512-vnmn/Qqn6aG0POAc9mIGzjq0IybrvxJXYDafNvp9JSnDGxeF3pbkSqLvf+YGd5ku63pT7sa/jxHn7/d0mU8+tA==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
				<!-- After three.js: deferred scripts run in document order. -->
				<script src="/assets/js/globe.js" defer></script>
			}
			<script src="/assets/js/app.js" defer></script>
		</body>
	</html>
}

// logo is the eye in the long grass: the site's mark, inline so it paints
// with the first byte of the page rather than a second request.
templ logo() {
	<svg class="logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
		<circle cx="16" cy="16" r="15" class="logo__disc"></circle>
		<path class="logo__grass" d="M3 29c2-6 4-9 6-11 0 5-1 8-2 11M9 29c1-8 3-12 6-15-1 7-2 11-3 15M16 29c0-9 2-14 5-18 0 8-1 13-2 18M23 29c1-6 3-10 6-13-1 6-2 9-3 13"></path>
		<ellipse cx="16" cy="13" rx="8" ry="5" class="logo__eye"></ellipse>
		<circle cx="16" cy="13" r="2.6" class="logo__pupil"></circle>
	</svg>
}
