package components

// Gopher is a small burrowing animal in profile, facing right, drawn from
// the site's own tokens: sage fur like the long grass in the logo, an eye
// built the way the logo's is, and the two front teeth that make a gopher
// a gopher at 40px. modifier is a second class, e.g. "gopher--run".
//
// It is decoration and says so: hidden from assistive technology and out
// of the tab order. Nothing on the page may depend on it.
templ Gopher(modifier string) {
	<svg class={ "gopher", modifier } viewBox="0 0 48 32" aria-hidden="true" focusable="false">
		<g class="gopher__bob">
			<path class="gopher__tail" d="M6 21c-4 0-5.5-5-3-8"></path>
			<!-- Two pairs, in step diagonally, so a stride reads as a stride. -->
			<g class="gopher__leg gopher__leg--b">
				<rect x="14" y="22" width="5" height="8.5" rx="2.5"></rect>
				<rect x="31" y="22" width="5" height="8.5" rx="2.5"></rect>
			</g>
			<circle class="gopher__ear" cx="29.5" cy="4.6" r="3"></circle>
			<path class="gopher__fur" d="M4.5 21C4.5 14 11 10.5 20 10.5c4.5 0 7-5.5 14-5.5 7 0 11.5 4.5 11.5 11 0 5-3.5 8.5-8 8.5H17C9 24.5 4.5 25 4.5 21z"></path>
			<g class="gopher__leg gopher__leg--a">
				<rect x="9" y="22" width="5.5" height="8.5" rx="2.75"></rect>
				<rect x="26" y="22" width="5.5" height="8.5" rx="2.75"></rect>
			</g>
			<ellipse class="gopher__muzzle" cx="40.8" cy="17" rx="4.4" ry="4.3"></ellipse>
			<ellipse class="gopher__eye" cx="37.2" cy="11.3" rx="3" ry="3.1"></ellipse>
			<circle class="gopher__pupil" cx="38.2" cy="11.7" r="1.5"></circle>
			<ellipse class="gopher__nose" cx="44.4" cy="14.6" rx="1.9" ry="1.5"></ellipse>
			<rect class="gopher__tooth" x="41.2" y="18.5" width="3.6" height="3.8" rx="0.8"></rect>
			<path class="gopher__gap" d="M43 19.4v2.6"></path>
		</g>
	</svg>
}

// GopherPeek is the same animal head-on, looking up out of a mound of
// earth: for the one place there is nothing yet to look at.
templ GopherPeek() {
	<svg class="gopher gopher--peek" viewBox="0 0 40 30" aria-hidden="true" focusable="false">
		<g transform="translate(0 -3.5)">
			<g class="gopher__rise">
				<circle class="gopher__ear" cx="11.5" cy="8" r="3.2"></circle>
				<circle class="gopher__ear" cx="28.5" cy="8" r="3.2"></circle>
				<circle class="gopher__fur" cx="20" cy="16" r="9.5"></circle>
				<ellipse class="gopher__eye" cx="16" cy="13.5" rx="2.8" ry="3"></ellipse>
				<ellipse class="gopher__eye" cx="24" cy="13.5" rx="2.8" ry="3"></ellipse>
				<circle class="gopher__pupil" cx="16.6" cy="14" r="1.4"></circle>
				<circle class="gopher__pupil" cx="23.4" cy="14" r="1.4"></circle>
				<ellipse class="gopher__muzzle" cx="20" cy="19" rx="5.5" ry="4.2"></ellipse>
				<ellipse class="gopher__nose" cx="20" cy="18.2" rx="2.2" ry="1.7"></ellipse>
				<rect class="gopher__tooth" x="18.1" y="19.6" width="1.8" height="3.4" rx="0.6"></rect>
				<rect class="gopher__tooth" x="20.1" y="19.6" width="1.8" height="3.4" rx="0.6"></rect>
			</g>
		</g>
		<path class="gopher__mound" d="M1 29.2C4 22.5 11 21 20 21s16 1.5 19 8.2z"></path>
	</svg>
}
