package pages

import (
	"strconv"
	"workshop/internal/domain/game"
	"workshop/web/views/layout"
)

// Question is a photograph and an empty map: the player says where on
// earth they think the animal was.
templ Question(props QuestionProps) {
	@layout.Base(layout.BaseProps{
		Title:       roundLabel(props.Game.Round + 1),
		Description: "Look at the animal. Guess where on earth it was seen. Five rounds, 25,000 points.",
		Map:         true,
		Class:       "is-playing",
	}) {
		@scoreboard(props.Game, props.Game.Round+1)
		<!--
			Source order is the order a phone shows: the photograph, then the map
			you answer on, then the clues, so the evidence and the control sit
			together. Desktop puts the clues beside the photograph with grid
			areas; the clues hold nothing focusable, so tab order is unaffected.
		-->
		<form class="round" method="post" action="/play/guess">
			<input type="hidden" name="round" value={ strconv.Itoa(props.Game.Round) }/>
			<figure class="plate">
				<img
					class="plate__photo"
					src={ photo(props.Sighting).URL }
					alt="An unidentified animal, photographed in the wild"
				/>
				<figcaption class="plate__credit">{ credit(photo(props.Sighting)) }</figcaption>
			</figure>
			<section class="guess" aria-label="Your guess">
				<div class="mapframe">
					<div
						class="map"
						data-safari-map="safari-map"
						role="group"
						aria-label="Map to place your guess on"
						aria-describedby="map-help"
					>
						<p class="map__fallback">
							<!-- One child, so the grid centres the sentence rather than splitting it around the link. -->
							<span>
								The map needs JavaScript and a connection. Without it, type a
								latitude and longitude below, or read every sighting on
								<a href="/">the record</a>.
							</span>
						</p>
					</div>
					<!-- Revealed by safari.js: it only means anything once the map is live. -->
					<div class="crosshair" data-crosshair hidden aria-hidden="true">
						<svg viewBox="0 0 48 48" focusable="false">
							<path class="crosshair__arm" d="M24 4v12M24 32v12M4 24h12M32 24h12"></path>
							<circle class="crosshair__ring" cx="24" cy="24" r="9"></circle>
							<circle class="crosshair__dot" cx="24" cy="24" r="1.5"></circle>
						</svg>
					</div>
				</div>
				<!--
					A guess does not need the map: a screen reader cannot aim a
					crosshair, and a blocked CDN leaves no map to click. These are
					the form's real fields, and the map only fills them in.
				-->
				<div class="coords">
					<div class="coords__field">
						<label for="lat">Latitude</label>
						<input
							type="number"
							step="any"
							min="-90"
							max="90"
							name="lat"
							id="lat"
							required
							autocomplete="off"
							aria-describedby="coords-help"
						/>
					</div>
					<div class="coords__field">
						<label for="lng">Longitude</label>
						<input
							type="number"
							step="any"
							min="-180"
							max="180"
							name="lng"
							id="lng"
							required
							autocomplete="off"
							aria-describedby="coords-help"
						/>
					</div>
					<p class="coords__help" id="coords-help">
						Latitude runs from -90 (south) to 90 (north), longitude from -180 (west) to 180 (east).
					</p>
				</div>
				<div class="guess__bar">
					<!-- Revealed by safari.js: there is no crosshair to read until the map is live. -->
					<p class="field__readout" id="crosshair-readout" aria-live="polite" hidden></p>
					<output class="field__readout" id="guess-readout" for="lat lng">No pin dropped yet</output>
					<!-- type="button": this sits inside the guess form and must not submit it. -->
					<button class="button" type="button" data-drop-centre hidden>
						Place pin at crosshair
					</button>
					<button class="button button--primary button--large" type="submit" id="guess-submit">
						Lock it in
					</button>
				</div>
			</section>
			<section class="panel" aria-labelledby="clues-heading">
				<h2 id="clues-heading" class="panel__title">What we know</h2>
				<dl class="clues">
					for _, clue := range clues(props.Sighting) {
						<div class="clue">
							<dt>{ clue.Label }</dt>
							<dd>{ clue.Value }</dd>
						</div>
					}
				</dl>
				<!--
					The first sentence is the whole instruction for a pointer. The rest
					is for the keyboard and the typed fields, and a phone has little
					room for it, so a narrow screen drops it (see .panel__hint-more).
				-->
				<p class="panel__hint" id="map-help">
					Click or tap the map to drop a pin where you think it was recorded.
					<span class="panel__hint-more">
						Or focus the map, pan with the arrow keys, and press Enter to place
						one at the crosshair. Or type a latitude and longitude under the
						map. The closer you are, the more it scores.
					</span>
				</p>
			</section>
		</form>
		@templ.JSONScript("safari-map", guessMap())
	}
}

// Answer is the round scored: how far out the guess was, and what the
// animal turned out to be.
templ Answer(props AnswerProps) {
	@layout.Base(layout.BaseProps{
		Title:       verdict(props.Result.DistanceKm),
		Description: "Look at the animal. Guess where on earth it was seen. Five rounds, 25,000 points.",
		Map:         true,
		Class:       "is-playing",
	}) {
		@scoreboard(props.Game, len(props.Game.Results))
		<section class="result">
			<header class={ "result__head", tone(props.Result.Points) }>
				<p class="result__verdict">{ verdict(props.Result.DistanceKm) }</p>
				<p class="result__distance">{ distanceLabel(props.Result.DistanceKm) }</p>
				<p class="result__points">
					<span class="result__points-value">+{ thousands(props.Result.Points) }</span>
					<span class="result__points-label">points</span>
				</p>
			</header>
			<div class="map map--answer" data-safari-map="safari-map" role="img" aria-label="Your guess and where the animal was really seen">
				<p class="map__fallback">{ distanceLabel(props.Result.DistanceKm) }</p>
			</div>
			<div class="reveal">
				<figure class="reveal__plate">
					<img src={ photo(props.Sighting).URL } alt={ speciesName(props.Sighting) }/>
					<figcaption>{ credit(photo(props.Sighting)) }</figcaption>
				</figure>
				<div class="reveal__body">
					<h2 class="reveal__name">{ speciesName(props.Sighting) }</h2>
					if props.Sighting.Species.ScientificName != "" {
						<p class="reveal__scientific">{ props.Sighting.Species.ScientificName }</p>
					}
					<dl class="clues">
						<div class="clue">
							<dt>Seen at</dt>
							<dd>{ place(props.Sighting.Location) }</dd>
						</div>
						<div class="clue">
							<dt>On</dt>
							<dd>{ props.Sighting.HappenedAt.Format("2 January 2006") }</dd>
						</div>
						<div class="clue">
							<dt>Position</dt>
							<dd class="mono">
								{ strconv.FormatFloat(props.Sighting.Location.Latitude, 'f', 4, 64) },
								{ strconv.FormatFloat(props.Sighting.Location.Longitude, 'f', 4, 64) }
							</dd>
						</div>
					</dl>
					if props.Sighting.ReferenceURL != "" {
						<p>
							<a class="link" href={ templ.URL(props.Sighting.ReferenceURL) } rel="noopener">
								The original record on GBIF
							</a>
						</p>
					}
				</div>
			</div>
			<div class="result__actions">
				if props.Game.Complete() {
					<a class="button button--primary" href="/play">See how you did</a>
				} else {
					<a class="button button--primary" href="/play">Next round</a>
				}
			</div>
		</section>
		@templ.JSONScript("safari-map", answerMap(props))
	}
}

// Over is the finished game: the total, what it makes the player, and a
// line they can paste anywhere.
templ Over(props OverProps) {
	@layout.Base(layout.BaseProps{
		Title:       "Final score",
		Description: "Look at the animal. Guess where on earth it was seen. Five rounds, 25,000 points.",
		Class:       "is-playing",
	}) {
		<section class={ "final", gameTone(props.Game) }>
			<p class="final__eyebrow">{ game.Name }</p>
			<p class="final__score">
				<span class="final__total">{ thousands(props.Game.Total()) }</span>
				<span class="final__max">/ { thousands(game.MaxScore) }</span>
			</p>
			<h1 class="final__rank">{ props.Game.Rank() }</h1>
			<ol class="rounds">
				for i, result := range props.Game.Results {
					<li class={ "rounds__row", tone(result.Points) }>
						<span class="rounds__n mono">{ strconv.Itoa(i + 1) }</span>
						<span class="rounds__medal" aria-hidden="true">{ game.Medal(result.Points) }</span>
						<span class="rounds__what">
							if name := props.playedName(i); name != "" {
								<span class="rounds__name">{ name }</span>
								<span class="rounds__place">{ props.playedPlace(i) }</span>
							} else {
								<span class="rounds__name">Round { strconv.Itoa(i + 1) }</span>
							}
							<span class="rounds__distance">{ distanceLabel(result.DistanceKm) }</span>
						</span>
						<span class="rounds__meter">
							<span class="rounds__fill" data-scale={ barScale(result.Points) }></span>
						</span>
						<span class="rounds__points mono">{ thousands(result.Points) }</span>
					</li>
				}
			</ol>
			<div class="share">
				<h2 class="share__title">Brag about it</h2>
				<pre class="share__text" id="share-text">{ props.Game.Share() }</pre>
				<button class="button" type="button" data-copy="share-text">Copy result</button>
			</div>
			<div class="final__actions">
				<a class="button button--primary" href="/play/new">Play again</a>
				<a class="button" href="/">Browse the record</a>
			</div>
		</section>
	}
}

// scoreboard is the strip above a round: where the player is, and what
// they have banked so far.
templ scoreboard(g game.Game, round int) {
	<div class="scoreboard">
		<p class="scoreboard__round">{ roundLabel(round) }</p>
		<ol class="pips" aria-label="Rounds played">
			for i := range game.Rounds {
				if i < len(g.Results) {
					<li class="pip pip--done" aria-label="Played">{ game.Medal(g.Results[i].Points) }</li>
				} else {
					<li class="pip" aria-hidden="true"></li>
				}
			}
		</ol>
		<p class="scoreboard__score">
			<span class="mono">{ thousands(g.Total()) }</span>
			<span class="scoreboard__score-label">points</span>
		</p>
	</div>
}
